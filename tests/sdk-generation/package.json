{
  "name": "libresign-sdk-generation-evaluation",
  "private": true,
  "version": "1.0.0",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "compile": "tsc --noEmit --strict --skipLibCheck --target ES2020 --module commonjs --moduleResolution node ../../build/sdk-generation/typescript/*.ts types.ts transport.ts live.ts",
    "test": "tsx transport.ts && node inventory.cjs",
    "test:live": "tsx live.ts",
    "test:anyof": "tsc --noEmit --strict --skipLibCheck --target ES2020 --module commonjs --moduleResolution node anyof-negative.ts"
  },
  "dependencies": {
    "axios": "1.9.0"
  },
  "devDependencies": {
    "@types/node": "22.15.21",
    "tsx": "4.19.4",
    "typescript": "5.8.3"
  }
}
