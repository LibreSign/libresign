{
	"$schema": "https://raw.githubusercontent.com/infection/infection/0.35.2/resources/schema.json",
	"source": {
		"directories": [
			"lib"
		],
		"excludes": [
			"Migration"
		]
	},
	"bootstrap": "tests/php/infection-bootstrap.php",
	"phpUnit": {
		"configDir": "tests/php"
	},
	"minMsi": 80,
	"minCoveredMsi": 80,
	"mutators": {
		"@default": true
	}
}
